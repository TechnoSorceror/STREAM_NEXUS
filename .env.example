# Create a TMDB account and add ONE of these server-side credentials.
# Never prefix either value with VITE_; doing so would expose it to browsers.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Local/LAN self-hosting settings.
HOST=0.0.0.0
PORT=3000

# Set this only after a public HTTPS domain points at this server.
# SITE_URL=https://streamnexus.example.com
